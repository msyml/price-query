# 本地开发用；线上（GitHub Actions）请把同名变量配置到仓库 Secrets
# 注意：本文件是示例，禁止填真实密钥；真实配置写在 .env（已被 .gitignore 忽略）

# 飞书自建应用凭证（开放平台开发者后台 -> 凭证与基础信息）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 数据源：多维表格 token 与数据表 id
FEISHU_APP_TOKEN=Opk7b7d0VaIm26sFhpRc3hbOnRb
FEISHU_TABLE_ID=tblwpCeIDAdL0RzH

# 页面访问口令（同时用于加密数据快照，务必与前端使用的一致）
ACCESS_PASSCODE=change-me

# Cloudflare Pages（仅本地发布需要；CI 走 GitHub Secrets）
CF_PROJECT_NAME=price-query
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=