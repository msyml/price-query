{
  "name": "price-query",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "价目表查询站点：飞书多维表格快照 + Cloudflare Pages",
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "dev": "wrangler pages dev public",
